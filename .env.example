# Copy to .env for local development. In production these come from the host's
# environment (Render sets them from render.yaml), not from a file.

# Required in production - the app refuses to boot without it.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Where the booking tracker and the ID counter are written. Leave unset to keep
# them beside the code; set it to a mounted disk on an ephemeral host.
DATA_DIR=
