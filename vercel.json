{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/api/index?__vpath=/" },
    { "source": "/(.*)", "destination": "/api/index?__vpath=/$1" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{templates/**,*.py}"
    }
  },
  "env": {
    "DATA_DIR": "/tmp/ticket-data"
  }
}
